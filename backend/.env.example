# Scribo Environment Configuration

# -----------------------------------------------------------------------------
# API Keys
# -----------------------------------------------------------------------------
# Gemini API Key (Required for note synthesis and default Gemini STT)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Groq API Key (for ultra-fast whisper-large-v3 STT)
GROQ_API_KEY=

# Optional: OpenAI API Key (for whisper-1 STT)
OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# Model & Provider Configuration
# -----------------------------------------------------------------------------
# Synthesis LLM (e.g. gemini-2.5-flash, gemini-1.5-flash, gemini-1.5-pro)
GEMINI_MODEL=gemini-1.5-flash

# Default STT Engine: "gemini", "groq", or "openai"
STT_PROVIDER=groq

# -----------------------------------------------------------------------------
# Audio Preprocessing & Compression Configuration
# -----------------------------------------------------------------------------
AUDIO_BITRATE=48k
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
